PORT=8791
APP_USERNAME=admin
APP_PASSWORD=change-me
LIST_USERS_LIMIT=250

# Legacy Render-only MySQL database.
LEGACY_DATABASE_URL=mysql://user:password@host:3306/database

# Target database. Use TARGET_DATABASE_URL for direct MySQL access,
# or PlanetScale credentials for the serverless driver.
TARGET_DB_MODE=planetscale
TARGET_DATABASE_HOST=
TARGET_DATABASE_USERNAME=
TARGET_DATABASE_PASSWORD=
# TARGET_DATABASE_URL=mysql://user:password@host:3306/database

# Optional, required only if you want the UI to suspend/delete
# legacy Render worker services before DB cleanup.
RENDER_API_KEY=
RENDER_API_BASE=https://api.render.com/v1
